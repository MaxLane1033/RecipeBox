# Local API and database only. Never copy secrets to EXPO_PUBLIC_* variables.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://recipebox:recipebox@localhost:5433/recipebox
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Browser origins only; native app schemes are configured by packages/auth.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
